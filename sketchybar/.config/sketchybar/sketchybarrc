#!/bin/bash
# SketchyBar — Catppuccin Mocha islands, AeroSpace workspaces, Hack Nerd Font

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="Hack Nerd Font"

##### Bar #####
sketchybar --bar \
  position=top \
  height=36 \
  color=$BAR_COLOR \
  shadow=off \
  sticky=on \
  padding_left=8 \
  padding_right=8

##### Defaults #####
default=(
  updates=when_shown
  padding_left=3
  padding_right=3
  icon.font="$FONT:Bold:15.0"
  label.font="$FONT:Bold:13.0"
  icon.color=$TEXT
  label.color=$TEXT
  icon.padding_left=8
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=8
  background.height=26
  background.corner_radius=9
)
sketchybar --default "${default[@]}"

# Shared look for the rounded "island" backgrounds
island=(
  background.color=$ISLAND_COLOR
  background.border_color=$ISLAND_BORDER
  background.border_width=1
  background.height=28
  background.corner_radius=10
)

##### Left: apple #####
sketchybar --add item apple left \
  --set apple \
    icon="$ICON_APPLE" \
    icon.font="$FONT:Bold:17.0" \
    icon.color=$ACCENT \
    icon.padding_left=12 \
    icon.padding_right=12 \
    label.drawing=off \
    "${island[@]}" \
    click_script="open -a 'System Settings'"

sketchybar --add item gap.left.1 left \
  --set gap.left.1 width=6 icon.drawing=off label.drawing=off

##### Left: AeroSpace workspaces #####
sketchybar --add event aerospace_workspace_change

WORKSPACES="$(aerospace list-workspaces --all 2>/dev/null)"
[ -z "$WORKSPACES" ] && WORKSPACES="1 2"

for sid in $WORKSPACES; do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change front_app_switched space_windows_change system_woke \
    --set space.$sid \
      icon="$sid" \
      icon.padding_left=10 \
      icon.padding_right=10 \
      icon.color=$OVERLAY0 \
      label.drawing=off \
      background.color=$ACCENT \
      background.height=22 \
      background.corner_radius=7 \
      background.drawing=off \
      padding_left=1 \
      padding_right=1 \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

sketchybar --add bracket spaces '/space\..*/' \
  --set spaces "${island[@]}"

sketchybar --add item gap.left.2 left \
  --set gap.left.2 width=6 icon.drawing=off label.drawing=off

##### Left: front app #####
sketchybar --add item front_app left \
  --set front_app \
    icon="$ICON_CHEVRON" \
    icon.font="$FONT:Bold:11.0" \
    icon.color=$ACCENT \
    icon.padding_left=12 \
    label.color=$TEXT \
    label.padding_right=12 \
    "${island[@]}" \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Right: clock (own island) #####
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    icon="$ICON_CLOCK" \
    icon.color=$ACCENT \
    icon.padding_left=12 \
    label.padding_right=12 \
    "${island[@]}" \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="open -a Calendar" \
  --subscribe clock system_woke

sketchybar --add item gap.right.1 right \
  --set gap.right.1 width=6 icon.drawing=off label.drawing=off

##### Right: status island (rightmost first) #####
sketchybar --add item battery right \
  --set battery \
    update_freq=120 \
    label.padding_right=12 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
  --set volume \
    icon.color=$BLUE \
    script="$PLUGIN_DIR/volume.sh" \
    click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
  --subscribe volume volume_change

sketchybar --add item wifi right \
  --set wifi \
    update_freq=30 \
    icon.color=$TEAL \
    label.drawing=off \
    icon.padding_right=8 \
    script="$PLUGIN_DIR/wifi.sh" \
    click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
  --subscribe wifi wifi_change system_woke

sketchybar --add item cpu right \
  --set cpu \
    update_freq=5 \
    icon="$ICON_CPU" \
    icon.color=$PEACH \
    icon.padding_left=12 \
    script="$PLUGIN_DIR/cpu.sh" \
    click_script="open -a 'Activity Monitor'"

sketchybar --add bracket status cpu wifi volume battery \
  --set status "${island[@]}"

##### Init #####
sketchybar --hotload on
sketchybar --update
